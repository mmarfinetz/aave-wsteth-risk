# --- required -----------------------------------------------------------------
# Websocket endpoint for Base. A plain https:// RPC will NOT work: the watcher needs a
# head subscription. Use a paid/private endpoint for a launch -- public ones throttle
# and drop exactly when everyone else is hammering them.
BASE_WSS=wss://base-mainnet.example/v2/YOUR_KEY

# Hot wallet holding only what you are willing to lose on this trade.
PRIVATE_KEY=0x...

# --- safety -------------------------------------------------------------------
# LIVE=false observes and prints; it never sends a transaction. Leave it false until
# you have watched a real preflight pass.
LIVE=false

# Absolute price floor, in whole tokens, for BUY_ETH worth of buying. REQUIRED when
# LIVE=true and the single most important setting here: slippage only protects you from
# drift against a quote just taken, it does NOT stop you buying into a pool that opened
# at an absurd price. Set it from the valuation you actually want to pay.
MIN_TOKENS_OUT=

# Refuse to buy a token whose sell side does not quote (REQUIRE_SELL_PATH=true, the
# default). Turning this off removes the honeypot / sell-tax check.
REQUIRE_SELL_PATH=true

# --- sizing -------------------------------------------------------------------
# Size in ETH or in USD, never both. BUY_USD reads Chainlink ETH/USD on Base at arm
# time and converts; preflight prints the price it used so you can eyeball it.
BUY_ETH=0.01
# BUY_USD=1000

# Minimum WETH in the pool before the bot will trade. This must scale with your size:
# a 0.227 ETH buy (~$1k) into a 5 WETH pool is roughly 9% price impact. For a
# four-figure buy, 25-50 WETH keeps impact near 1-2%.
MIN_WETH_LIQ=5

SLIPPAGE_BPS=500
GAS_BUFFER_ETH=0.0005

# Hard cap on estimated price impact, in bps. 1000 = refuse to trade if the fill is
# more than 10% worse than the pool's undisturbed price. Set 0 to disable.
MAX_PRICE_IMPACT_BPS=1000

# Reject the ETH/USD feed if its last update is older than this (seconds).
MAX_FEED_AGE_SEC=3600

# --- timing -------------------------------------------------------------------
# No buy is attempted before this instant, whatever liquidity appears.
EARLIEST_BUY=2026-09-09T00:00:00-04:00

# Discard a quote older than this before sending (ms).
MAX_SCAN_STALENESS_MS=4000

# Rebuild the socket after this much silence (ms). Base blocks are ~2s.
BLOCK_WATCHDOG_MS=60000

# --- exit: CoW take-profit ladder ---------------------------------------------
# Rungs are <multiple>x:<percent of the position>, priced off the ACTUAL entry.
# Percentages are of the original position and may not exceed 100%.
EXIT_LADDER=3x:25,5x:25,10x:50

# How long each resting order stays valid, in hours.
EXIT_TTL_HOURS=72

# WETH or ETH. WETH is the plain ERC-20 path; ETH uses CoW's native-out sentinel.
EXIT_RECEIVE=WETH

COW_BASE_URL=https://api.cow.fi

# Written by the sniper on a fill; read by scripts/exit.js to price the ladder.
POSITION_FILE=./position.json
