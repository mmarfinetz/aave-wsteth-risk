# CoinGecko API key — get a free Demo key at https://www.coingecko.com/en/api/pricing
# Use COINGECKO_API_KEY for a paid Pro key, or COINGECKO_DEMO_API_KEY for the free Demo tier.
COINGECKO_API_KEY=your-api-key-here

# Optional — higher-rate on-chain eth_call fetches (fallback; public RPCs used by default).
ETHERSCAN_API_KEY=your-etherscan-api-key-here

# Optional — required only for live 0x Swap API planning/execution payloads.
ZEROX_API_KEY=

# Optional — required only for live 1inch Classic Swap API planning/execution payloads.
ONEINCH_API_KEY=

# Optional — custom Ethereum JSON-RPC endpoint. Free public RPCs (PublicNode, 1RPC, dRPC, Cloudflare)
# are used by default, so this is only needed if you want to use your own node or
# a provider like Alchemy/Infura.
ETH_RPC_URL=

# Optional — The Graph gateway API key. Used when AAVE_SUBGRAPH_URL is in
# gateway form without embedded key (/api/subgraphs/id/...).
GRAPH_API_KEY=

# Required for live runs — Aave V3 subgraph endpoint for borrower/cohort analytics.
# Also used by optional account-level cascade replay.
# Supported formats:
# 1) https://gateway.thegraph.com/api/subgraphs/id/<subgraph_id>   (requires GRAPH_API_KEY)
# 2) https://gateway.thegraph.com/api/<key>/subgraphs/id/<subgraph_id>
AAVE_SUBGRAPH_URL=

# Optional dashboard scenario defaults.
# Stablecoin debt mode uses live/cached Aave reserve-rate data when available.
# Set this only to override that rate. Decimal format: 0.065 = 6.5%.
DASHBOARD_DEBT_MODE=weth
DASHBOARD_DEBT_ASSET=WETH
DASHBOARD_STABLECOIN_BORROW_APY=

# Optional ETH/USD view over the simulation horizon. Decimal format: 0.20 = +20%.
DASHBOARD_ETH_EXPECTED_RETURN=
DASHBOARD_ETH_ENTRY_PRICE_USD=
DASHBOARD_ETH_PRICE_MODEL=gbm
DASHBOARD_ETH_MEAN_REVERSION_TARGET_USD=
DASHBOARD_ETH_MEAN_REVERSION_HALF_LIFE_DAYS=
DASHBOARD_ETH_MEAN_REVERSION_SPEED_ANNUAL=

# Optional professional-model optimizer constraints.
DASHBOARD_OPTIMIZATION_MIN_LOOPS=
DASHBOARD_OPTIMIZATION_MAX_LOOPS=
DASHBOARD_OPT_MAX_PROB_HF_LT_1_PCT=
DASHBOARD_OPT_MIN_START_HF=
DASHBOARD_OPT_MAX_ENTRY_COST_BPS=
DASHBOARD_OPT_MAX_UNWIND_COST_BPS=
DASHBOARD_OPT_UNWIND_STRESS_MULTIPLIER=

# Optional trading-model layers for the API's GET /api/dashboard defaults.
# DASHBOARD_MARKET_REGIME_FORECAST=true makes the server fetch Deribit
# features (enables the regime forecast and, when a persisted gated model
# exists in data/cache, the supervised touch-probability forecast).
DASHBOARD_MARKET_REGIME_FORECAST=
DASHBOARD_TOUCH_MODEL_FORECAST=
DASHBOARD_SIZING_KELLY_FRACTION=
DASHBOARD_SIZING_CVAR_BUDGET_PCT=
DASHBOARD_EXIT_LADDER=

# Optional entry-sweep report controls for stablecoin debt trades.
# Use either explicit comma-separated prices or generated min/max/step/points.
DASHBOARD_ENTRY_SWEEP_PRICES_USD=
DASHBOARD_ENTRY_SWEEP_MIN_USD=
DASHBOARD_ENTRY_SWEEP_MAX_USD=
DASHBOARD_ENTRY_SWEEP_STEP_USD=
DASHBOARD_ENTRY_SWEEP_POINTS=
DASHBOARD_ENTRY_SWEEP_TARGET_USD=
DASHBOARD_ENTRY_SWEEP_MAX_PATHS=
